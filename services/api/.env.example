# MSGI One FastAPI Backend — Environment Variable Template (Placeholders Only)
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
PROJECT_NAME="MSGI One API"

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=replace-with-strong-jwt-secret
SUPABASE_JWT_PUBLIC_KEY=
JWT_AUDIENCE=authenticated
JWT_REQUIRE_ISSUER=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# AI Orchestration & Encrypted Provider Vault
AI_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_VAULT_MASTER_KEY=replace-with-32-plus-char-master-key-for-aes256gcm

# Real-Time Messaging Bus & LiveKit Media
REDIS_URL=redis://localhost:6379/0
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
