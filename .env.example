# MSGI One — Environment Variable Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS OR KEYS TO VERSION CONTROL

# ==========================================
# 1. APPLICATION ENVIRONMENT
# ==========================================
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="MSGI One — Agentic AI Institutional Alumni Ecosystem"

# ==========================================
# 2. SUPABASE INFRASTRUCTURE (BACKEND & MOBILE)
# ==========================================
# Public Supabase URL (Used by both backend and Expo mobile app)
SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Publishable Key (Safe for Mobile client)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (BACKEND ONLY — NEVER EXPOSE TO MOBILE APP)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# PostgreSQL Database Connection String (Direct or Transaction Pooler via Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==========================================
# 3. AGENTIC AI & LLM PROVIDER CREDENTIALS (BACKEND ONLY)
# ==========================================
# Google Gemini API Key (Default recommended provider for LangGraph)
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Optional secondary provider keys (for fallback)
OPENAI_API_KEY=your-openai-api-key-placeholder
ANTHROPIC_API_KEY=your-anthropic-api-key-placeholder

# LangGraph Checkpoint Database URL (Default shares PostgreSQL)
LANGGRAPH_CHECKPOINT_DB_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ==========================================
# 4. BACKEND API HOSTING & CORS
# ==========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","https://msgi-one.internal"]

# Backend URL exposed to Mobile Client
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# ==========================================
# 5. MOBILE NOTIFICATIONS & PUSH (FIREBASE FCM)
# ==========================================
FCM_SERVER_KEY=your-fcm-server-key-placeholder
